{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "template_toolkit",
      "camelcase": "TemplateToolkit",
      "scope": "source.tt2",
      "path": ".",
      "file-types": [
        "tt",
        "tt2",
        "tmpl"
      ],
      "injection-regex": "^(tt2?|template[-_]toolkit)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Template Toolkit 2 (TT2) grammar for tree-sitter",
    "authors": [
      {
        "name": "Ruvym Sypa",
        "email": "ruvimsypa@gmail.com"
      }
    ]
  }
}
